  "type": "module",
  "main": "index.js",
  "author": "aaaLittleCloud",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aaaLittleCloud/dsh-loan-cal.git"
  },
  "homepage": "https://github.com/aaaLittleCloud/dsh-loan-cal#readme",
  "bugs": {
    "url": "https://github.com/aaaLittleCloud/dsh-loan-cal/issues"
  },
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
